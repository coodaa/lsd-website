---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import { fix, getFirstImage, getDescription } from "../../components/utils/fix.js";

const baseUrl = import.meta.env.WP_API;
const slug = Astro.params.slug;

const sortByMenuOrder = (a, b) => {
  const ao = Number(a?.menu_order ?? 0);
  const bo = Number(b?.menu_order ?? 0);
  if (ao !== bo) return ao - bo;
  return fix(a?.title?.rendered || "").localeCompare(
    fix(b?.title?.rendered || ""),
    "de",
  );
};

const allRes = await fetch(
  `${baseUrl}/pages?per_page=100&orderby=menu_order&order=asc&status=publish`,
);
const pages = await allRes.json();

const res = await fetch(`${baseUrl}/pages?slug=${slug}&status=publish`);
const data = await res.json();
const page = data?.[0] ?? null;

const mainPages = pages.filter((p) => p.parent === 0).sort(sortByMenuOrder);

let sortedMainPages = mainPages.filter((p) => {
  const t = (p.title?.rendered || "").toLowerCase();
  return !t.includes("impressum") && !t.includes("datenschutz");
});

const kontaktIndex = sortedMainPages.findIndex((p) => p.slug === "kontakt");
if (kontaktIndex > -1) {
  const [kontakt] = sortedMainPages.splice(kontaktIndex, 1);
  sortedMainPages.push(kontakt);
}

const parentPage = page ? pages.find((p) => p.id === page.parent) : null;
const navAncestor = parentPage?.parent === 0
  ? parentPage
  : pages.find((p) => p.id === parentPage?.parent && p.parent === 0);

const footerPages = pages
  .filter((p) => {
    const t = (p.title?.rendered || "").toLowerCase();
    return t.includes("impressum") || t.includes("datenschutz");
  })
  .sort(sortByMenuOrder);

// Antwort 10 Minuten im Vercel-Zwischenspeicher behalten (danach noch einen Tag veraltet ausliefern,
// während im Hintergrund neu gerendert wird). Ohne das läuft für jeden Besuch und jeden Crawler eine
// eigene Funktion samt zwei WordPress-Abfragen. Änderungen im WordPress erscheinen nach spätestens
// zehn Minuten. Steht bewusst nach den Abfragen: schlägt eine fehl, wird der Fehler nicht gespeichert.
Astro.response.headers.set("Cache-Control", "public, s-maxage=600, stale-while-revalidate=86400");
---

<BaseLayout
  title={fix(page?.title?.rendered || "LSD Berlin")}
  description={getDescription(page?.content?.rendered || "")}
  image={getFirstImage(page?.content?.rendered || "") ?? undefined}
  pageUrl={`https://lsd-berlin.de/deep/${slug}`}
  ogType="article"
  bodyClass="deep-page detail-page has-detail-close"
>
  <div class="grid-layout">
    <Sidebar
      pages={sortedMainPages}
      activeSlug={navAncestor?.slug ?? slug}
      footerPages={footerPages}
    />

    <main class="content-area">
      <div class="content">
        <a href="/" class="detail-close">X</a>

        {
          page ? (
            <div
              class="wp-content"
              set:html={fix(page.content?.rendered || "")}
            />
          ) : (
            <div class="wp-content">
              <p>Seite nicht gefunden.</p>
            </div>
          )
        }
      </div>
    </main>
  </div>
</BaseLayout>
